{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: OpenOCD: Flash project (STLink)",
      "type": "process",
      "command": "D:\\openocd\\bin\\openocd.exe",
      "args": [
        "-s",
        "D:\\openocd\\share\\openocd\\scripts",
        "-f",
        // 烧录器 cmsis-dap stlink jlink
        "interface/stlink.cfg",
        "-c",
        "transport select hla_swd",
        "-c",
        "adapter speed 2000",
        "-f",
        // 芯片类型
        "target/stm32f4x.cfg",
        "-c",
        // 文件名
        "program {${command:cmake.buildDirectory}/basic.elf} verify reset exit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": true
      }
    }
  ]
}